# BHUMI-X Environment Configuration Template

# Server Configuration
BHUMIX_HOST=0.0.0.0
BHUMIX_PORT=8000
FRONTEND_PORT=5173

# Google Earth Engine (Optional Service Account)
# If left empty, BHUMI-X automatically operates in resilient fallback mode
# using direct Copernicus, NASA POWER, and Open-Meteo REST APIs.
GOOGLE_APPLICATION_CREDENTIALS=
GEE_SERVICE_ACCOUNT=

# External API Endpoints (All Public Open-Access, Zero API Key Required)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Model Configuration
BHUMIX_CHECKPOINT_PATH=ml/weights/bhumix_checkpoint.pt
CONFORMAL_ALPHA=0.10
MAHALANOBIS_OOD_PERCENTILE=97.5

